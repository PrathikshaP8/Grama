# MongoDB (local or Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/gramcare

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Aadhaar hashing pepper (demo/hackathon simulation — not UIDAI)
AADHAAR_PEPPER=change-me-aadhaar-pepper-secret!!

# Field encryption key (32-byte hex or passphrase)
FIELD_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Gemini (Google AI Studio)
GEMINI_API_KEY=

# Server
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Demo OTP: in development, OTP is returned in API responses
OTP_TTL_SECONDS=300
